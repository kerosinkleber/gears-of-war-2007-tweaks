// Version information of d3d9.dll (Properties, Details). No manifest: Windows only uses
// manifests for programs, and one in a DLL would change how its dependencies are loaded.
#include <winver.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION ROWE_VERSION_BIN
 PRODUCTVERSION ROWE_VERSION_BIN
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", ROWE_AUTHOR
            VALUE "FileDescription", "ROWE for Gears of War (2007) - FOV, lens correction and supersampling mod"
            VALUE "FileVersion", ROWE_VERSION_STR
            VALUE "InternalName", "rowe"
            VALUE "LegalCopyright", ROWE_COPYRIGHT
            VALUE "OriginalFilename", "d3d9.dll"
            VALUE "ProductName", ROWE_PRODUCT
            VALUE "ProductVersion", ROWE_PRODUCT_VERSION_STR
            VALUE "Comments", ROWE_URL
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
